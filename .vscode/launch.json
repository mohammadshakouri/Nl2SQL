{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Eval (single-pass)",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/cli_eval.py",
			"args": ["--dataset", "${input:dataset}", "--limit", "${input:limit}"],
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"justMyCode": false
		},
		{
			"name": "Eval (feedback loop)",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/cli_eval.py",
			"args": ["--dataset", "${input:dataset}", "--limit", "${input:limit}", "--feedback"],
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"justMyCode": false
		},
		{
			"name": "Eval (feedback loop + execution)",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/cli_eval.py",
			"args": ["--dataset", "${input:dataset}", "--limit", "${input:limit}", "--exec-feedback"],
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"justMyCode": false
		},
		{
			"name": "Eval (compare modes)",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/cli_eval.py",
			"args": ["--dataset", "${input:dataset}", "--limit", "${input:limit}", "--compare"],
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"justMyCode": false
		}
	],
	"inputs": [
		{
			"id": "dataset",
			"type": "pickString",
			"description": "Benchmark to evaluate (the data folder is ./Spider or ./BIRD)",
			"options": ["spider", "bird"],
			"default": "spider"
		},
		{
			"id": "limit",
			"type": "promptString",
			"description": "Number of samples to evaluate (the first N of dev.json)",
			"default": "20"
		}
	]
}
