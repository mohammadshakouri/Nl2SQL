{
	"version": "0.2.0",
	"compounds": [
		{
			"name": "Backend/Frontend",
			"configurations": ["Backend", "Frontend"]
		}
	],
	"configurations": [
		{
			"name": "Spider Eval (single-pass)",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/backend/cli_spider_eval.py",
			"args": ["--spider_path", "${input:spiderPath}", "--limit", "${input:limit}"],
			"cwd": "${workspaceFolder}/backend",
			"console": "integratedTerminal",
			"justMyCode": false
		},
		{
			"name": "Spider Eval (feedback loop)",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/backend/cli_spider_eval.py",
			"args": ["--spider_path", "${input:spiderPath}", "--limit", "${input:limit}", "--feedback"],
			"cwd": "${workspaceFolder}/backend",
			"console": "integratedTerminal",
			"justMyCode": false
		},
		{
			"name": "Spider Eval (compare modes)",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/backend/cli_spider_eval.py",
			"args": ["--spider_path", "${input:spiderPath}", "--limit", "${input:limit}", "--compare"],
			"cwd": "${workspaceFolder}/backend",
			"console": "integratedTerminal",
			"justMyCode": false
		},
		{
			"name": "Backend",
			"type": "debugpy",
			"request": "launch",
			"module": "uvicorn",
			"args": ["main:app", "--host", "127.0.0.1", "--port", "80", "--reload"],
			"jinja": true,
			"cwd": "${workspaceFolder}/backend",
			"console": "integratedTerminal",
			"justMyCode": true,
			"subProcess": true
		},
		{
			"name": "Frontend",
			"type": "chrome",
			"request": "launch",
			"url": "http://localhost:5173",
			"webRoot": "${workspaceFolder}/frontend/src",
			"runtimeArgs": ["--remote-debugging-port=9222"],
			"sourceMaps": true,
			"preLaunchTask": "client",
			"postDebugTask": "terminate-client",
			"internalConsoleOptions": "neverOpen",
			"outputCapture": "std",
			"resolveSourceMapLocations": [
				"${workspaceFolder}/**",
				"!**/node_modules/**"
			]
		}
	],
	"inputs": [
		{
			"id": "spiderPath",
			"type": "promptString",
			"description": "Path to the Spider dataset root directory",
			"default": "./spider"
		},
		{
			"id": "limit",
			"type": "promptString",
			"description": "Number of samples to evaluate (leave blank for all)",
			"default": "20"
		}
	]
}

